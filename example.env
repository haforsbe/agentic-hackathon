# Used by: 01-microsoft-foundry-agents/, 02-agent-framework ADVANCED/, and
# 04-Agent Examples/05-support-ticket-system (ADVANCED)/
AZURE_AI_PROJECT_ENDPOINT=<REDACTED_URL>

# Used by: 01-microsoft-foundry-agents/01-quickstart-responses.py,
# 01-microsoft-foundry-agents/02-quickstart-create-agent.py,
# 02-agent-framework ADVANCED/, and 04-Agent Examples/05-support-ticket-system (ADVANCED)/
