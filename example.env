# Used by: 01-microsoft-foundry-agents/02-quickstart-create-agent.py and
# 01-microsoft-foundry-agents/03-quickstart-chat-with-agent.py
AGENT_NAME="Request-Coordinator"

# Optional. Used by: 02-agent-framework ADVANCED/ and
# 04-Agent Examples/05-support-ticket-system (ADVANCED)/agent_with_mcp.py
AZURE_CLI_PROCESS_TIMEOUT="60"
